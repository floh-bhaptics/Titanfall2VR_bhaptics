           (RuntimeLibrary=MT_StaticRelease, _ITERATOR_DEBUG_LEVEL=0). Using /MTd here would
           fail to link with LNK2038. Debug only differs by disabled optimization. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>$(ProjectDir)lib\BHapticsWrapper.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Packaging and deploying to $(Tf2GameDir)\$(Tf2Profile)</Message>
      <Command>rem ---- Package: zip that users unpack into their TF2VR folder ----
set "PKG_DIR=$(OutDir)package"
