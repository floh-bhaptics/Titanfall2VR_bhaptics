<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{1E7B7FFF-9DC8-4DB7-855B-0BE835CB5A6E}</ProjectGuid>
    <RootNamespace>Titanfall2VR_bhaptics</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!-- ===== Deployment settings: adjust here ===== -->
  <PropertyGroup Label="UserMacros">
    <!-- Titanfall 2 install folder -->
    <Tf2GameDir>G:\SteamLibrary\steamapps\common\Titanfall2</Tf2GameDir>
    <!-- Northstar profile used by the TF2VR installer's "Launch in VR" -->
    <Tf2Profile>TF2VR</Tf2Profile>
    <!-- Set to false to build without copying into the game -->
    <DeployToGame>true</DeployToGame>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>Titanfall2VR_bhaptics</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>Disabled</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <PreprocessorDefinitions>TF2VR_BH_DEBUG;WIN32_LEAN_AND_MEAN;NOMINMAX;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)lib;$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Static release CRT in BOTH configurations: BHapticsWrapper.lib is built with /MT
           (RuntimeLibrary=MT_StaticRelease, _ITERATOR_DEBUG_LEVEL=0). Using /MTd here would
           fail to link with LNK2038. Debug only differs by disabled optimization. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(ProjectDir)lib\BHapticsWrapper.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Packaging and deploying to $(Tf2GameDir)\$(Tf2Profile)</Message>
      <Command>rem ---- Package: zip that users unpack into their TF2VR folder ----
set "PKG_DIR=$(OutDir)package"
set "PKG_ZIP=$(OutDir)Titanfall2VR_bhaptics.zip"
if exist "%PKG_DIR%" rmdir /s /q "%PKG_DIR%"
if exist "%PKG_ZIP%" del /q "%PKG_ZIP%"
xcopy /Y /Q "$(TargetPath)" "%PKG_DIR%\plugins\" &gt;nul || (echo ERROR: packaging failed ^(plugin^) &amp; exit /b 1)
xcopy /Y /Q "$(ProjectDir)lib\bhaptics\bhaptics_library.dll" "%PKG_DIR%\plugins\lib\" &gt;nul || (echo ERROR: packaging failed ^(bhaptics_library.dll^) &amp; exit /b 1)
xcopy /Y /Q /E /I "$(ProjectDir)mod\Titanfall2VR_bhaptics" "%PKG_DIR%\mods\Titanfall2VR_bhaptics\" &gt;nul || (echo ERROR: packaging failed ^(mod folder^) &amp; exit /b 1)
tar -a -c -f "%PKG_ZIP%" -C "%PKG_DIR%" plugins mods || (echo ERROR: could not create "%PKG_ZIP%" &amp; exit /b 1)
echo Packaged "%PKG_ZIP%"

rem ---- Deploy to the local game install ----
if /I not "$(DeployToGame)"=="true" (
  echo Deployment disabled ^(DeployToGame=false^)
  exit /b 0
)
set "PROFILE_DIR=$(Tf2GameDir)\$(Tf2Profile)"
if not exist "%PROFILE_DIR%\Northstar.dll" (
  echo ERROR: "%PROFILE_DIR%\Northstar.dll" not found. Install Titanfall 2 VR with CircuitLord's installer first, or fix Tf2GameDir/Tf2Profile in the project file.
  exit /b 1
)
xcopy /Y /Q "$(TargetPath)" "%PROFILE_DIR%\plugins\"
if errorlevel 1 (
  echo ERROR: Could not copy the plugin. Is the game still running?
  exit /b 1
)
xcopy /Y /Q /D "$(ProjectDir)lib\bhaptics\bhaptics_library.dll" "%PROFILE_DIR%\plugins\lib\"
if errorlevel 1 (
  echo ERROR: Could not copy bhaptics_library.dll
  exit /b 1
)
xcopy /Y /Q /E /I "$(ProjectDir)mod\Titanfall2VR_bhaptics" "%PROFILE_DIR%\mods\Titanfall2VR_bhaptics\"
if errorlevel 1 (
  echo ERROR: Could not copy the mod folder
  exit /b 1
)
echo Deployed to %PROFILE_DIR%</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <PreprocessorDefinitions>NDEBUG;WIN32_LEAN_AND_MEAN;NOMINMAX;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)lib;$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
