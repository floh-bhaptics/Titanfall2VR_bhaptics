if not exist "%PROFILE_DIR%\Northstar.dll" (
  echo ERROR: "%PROFILE_DIR%\Northstar.dll" not found. Install Titanfall 2 VR with CircuitLord's installer first, or fix Tf2GameDir/Tf2Profile in the project file.
  exit /b 1
)
xcopy /Y /Q "$(TargetPath)" "%PROFILE_DIR%\plugins\"
if errorlevel 1 (
  echo ERROR: Could not copy the plugin. Is the game still running?
  exit /b 1
)
xcopy /Y /Q /D "$(ProjectDir)lib\bhaptics\bhaptics_library.dll" "%PROFILE_DIR%\plugins\lib\"
if errorlevel 1 (
  echo ERROR: Could not copy bhaptics_library.dll
  exit /b 1
)
xcopy /Y /Q /E /I "$(ProjectDir)mod\Titanfall2VR_bhaptics" "%PROFILE_DIR%\mods\Titanfall2VR_bhaptics\"
if errorlevel 1 (
  echo ERROR: Could not copy the mod folder
  exit /b 1
